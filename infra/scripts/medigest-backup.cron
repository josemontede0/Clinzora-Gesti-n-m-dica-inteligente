# Instalación sin Docker (Linux): copie a /etc/cron.d/medigest-backup y ajuste rutas y usuario.
# Respaldo diario 02:30, conserva 30 días. Las variables sensibles van en /etc/medigest/backup.env (permisos 600).
30 2 * * * medigest . /etc/medigest/backup.env && cd /opt/medigest && infra/scripts/backup.sh >> /var/log/medigest-backup.log 2>&1 && find "$BACKUP_DIR" -name 'medigest-*' -mtime +30 -delete
