{
  "name": "medigest",
  "private": true,
  "version": "0.1.0",
  "description": "Clinzora — Gestión médica inteligente (un producto de KonviaRD)",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm --filter @medigest/shared build && pnpm --filter @medigest/api build && pnpm --filter @medigest/web build",
    "build:shared": "pnpm --filter @medigest/shared build",
    "dev:api": "pnpm --filter @medigest/api dev",
    "dev:web": "pnpm --filter @medigest/web dev",
    "db:migrate": "pnpm --filter @medigest/api prisma:migrate",
    "db:deploy": "pnpm --filter @medigest/api prisma:deploy",
    "db:seed": "pnpm --filter @medigest/api seed",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @medigest/shared test && pnpm --filter @medigest/api test",
    "test:e2e": "pnpm --filter @medigest/api test:e2e",
    "test:ui": "pnpm --filter @medigest/web test:ui"
  }
}
