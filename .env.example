# ── API (apps/api/.env) ──────────────────────────────────────────
NODE_ENV=development
PORT=3001
# En producción la API escucha en localhost detrás del proxy HTTPS (Nginx/Caddy).
API_HOST=127.0.0.1
# Origen público del frontend (CORS y verificación de Origin en peticiones que modifican datos).
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://medigest:CAMBIAR@127.0.0.1:5435/medigest?schema=public
# Base exclusiva para pruebas e2e (se borra y recrea en cada corrida).
TEST_DATABASE_URL=postgresql://medigest:CAMBIAR@127.0.0.1:5435/medigest_test?schema=public

# Secretos: generar con  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=CAMBIAR
# 64 caracteres hex (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=CAMBIAR
FILE_URL_SECRET=CAMBIAR

SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Archivos privados (fuera de cualquier carpeta pública).
STORAGE_DIR=../../infra/storage

# Opcional. Si se define, los envíos de notificaciones se encolan en BullMQ; si no, cola en Postgres.
# REDIS_URL=redis://127.0.0.1:6379

# ── Notificaciones ──
# test = adaptadores de prueba: NO salen mensajes reales; quedan marcados como "modo prueba".
# live = usa los proveedores configurados abajo.
NOTIFICATIONS_MODE=test
MAIL_OUTBOX_DIR=../../infra/mail-outbox
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Centro Médico <no-responder@ejemplo.do>"
# WhatsApp Business Cloud API (Meta) — requiere cuenta verificada y plantillas aprobadas.
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# SMS (Twilio u otro proveedor compatible).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# ── Pagos con tarjeta ──
# test = terminal de pruebas (aprobación simulada y marcada como prueba). No usar en producción.
# Para producción implementar el adaptador del procesador elegido (CardNet, Azul, etc.).
PAYMENTS_PROVIDER=test

# ── Fiscal (DGII) ──
# manual = NCF tomados de los rangos autorizados que se cargan en Configuración > Fiscal.
# El envío de e-CF requiere un proveedor certificado o certificación propia ante la DGII.
FISCAL_PROVIDER=manual

# ── Web (apps/web/.env) ──────────────────────────────────────────
# API_URL=http://127.0.0.1:3001
